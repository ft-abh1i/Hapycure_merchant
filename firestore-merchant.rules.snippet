rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isNumber(value) {
      return value is int || value is float;
    }

    function isMarketplaceDocument(data) {
      return data.source == "hapycure-merchant";
    }

    function validApproval(data) {
      return data.approvalStatus is string
        && (data.approvalStatus == "pending"
          || data.approvalStatus == "approved"
          || data.approvalStatus == "rejected")
        && data.submittedAt is timestamp
        && (data.reviewedAt == null || data.reviewedAt is timestamp)
        && data.reviewedBy is string
        && data.reviewedBy.size() <= 100;
    }

    function validMerchantApprovalChange() {
      return (
          !resource.data.keys().hasAny(["approvalStatus"])
          && request.resource.data.approvalStatus == "pending"
        ) || request.resource.data.approvalStatus == resource.data.approvalStatus
        || (
          request.resource.data.approvalStatus == "pending"
          && request.resource.data.reviewedAt == null
          && request.resource.data.reviewedBy == ""
        );
    }

    function validUser(data) {
      return data.keys().hasOnly([
          "uid", "name", "email", "phone", "photoURL", "provider",
          "lastLoginAt", "dietProfile", "dietProfileCompleted",
          "dietProfileUpdatedAt"
        ])
        && data.keys().hasAll([
          "uid", "name", "email", "phone", "photoURL", "provider",
          "lastLoginAt"
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.name is string
        && data.name.size() <= 100
        && data.email is string
        && data.email.size() <= 200
        && data.phone is string
        && data.phone.size() <= 20
        && data.photoURL is string
        && data.photoURL.size() <= 2048
        && (data.provider == "google" || data.provider == "phone")
        && data.lastLoginAt is timestamp
        && (!data.keys().hasAny(["dietProfile"]) || data.dietProfile is map)
        && (!data.keys().hasAny(["dietProfileCompleted"]) || data.dietProfileCompleted is bool)
        && (!data.keys().hasAny(["dietProfileUpdatedAt"]) || data.dietProfileUpdatedAt is timestamp);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow create, update: if signedIn()
        && request.auth.uid == userId
        && validUser(request.resource.data);

      allow delete: if signedIn() && request.auth.uid == userId;
    }

    function validSupportTicket(data, ticketId) {
      return data.keys().hasOnly([
          "ticketId", "issueType", "orderId", "details", "status", "source",
          "userId", "userPhone", "userEmail", "createdAt", "localCreatedAt"
        ])
        && data.keys().hasAll([
          "ticketId", "issueType", "orderId", "details", "status", "source",
          "userId", "userPhone", "userEmail", "createdAt", "localCreatedAt"
        ])
        && data.ticketId == ticketId
        && data.ticketId.matches("^NUT-[0-9]{6}$")
        && data.userId == request.auth.uid
        && data.issueType is string
        && data.issueType.size() > 0
        && data.issueType.size() <= 100
        && data.orderId is string
        && data.orderId.size() <= 100
        && data.details is string
        && data.details.size() >= 15
        && data.details.size() <= 2000
        && data.status == "pending"
        && data.source == "help-support-page"
        && data.userPhone is string
        && data.userPhone.size() <= 20
        && data.userEmail is string
        && data.userEmail.size() <= 200
        && data.createdAt is timestamp
        && data.localCreatedAt is string
        && data.localCreatedAt.size() <= 50;
    }

    match /supportTickets/{ticketId} {
      allow create: if signedIn()
        && validSupportTicket(request.resource.data, ticketId);

      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow update, delete: if isAdmin();
    }

    function validRestaurant(data, restaurantId) {
      return data.keys().hasOnly([
          "ownerId", "service", "name", "subtype", "foodType", "phone",
          "address", "latitude", "longitude", "accuracy", "openTime",
          "closeTime", "image", "bannerImage", "bannerPublicId", "open",
          "published", "approvalStatus", "submittedAt", "reviewedAt",
          "reviewedBy", "source", "updatedAt"
        ])
        && data.keys().hasAll([
          "ownerId", "service", "name", "subtype", "foodType", "phone",
          "address", "latitude", "longitude", "accuracy", "openTime",
          "closeTime", "image", "bannerImage", "bannerPublicId", "open",
          "published", "approvalStatus", "submittedAt", "reviewedAt",
          "reviewedBy", "source", "updatedAt"
        ])
        && restaurantId == request.auth.uid
        && data.ownerId == request.auth.uid
        && data.source == "hapycure-merchant"
        && (data["service"] == "food" || data["service"] == "mess")
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.subtype is string
        && data.subtype.size() <= 100
        && data.foodType is string
        && data.foodType.size() <= 100
        && data.phone is string
        && data.phone.size() <= 20
        && data.address is string
        && data.address.size() > 0
        && data.address.size() <= 500
        && isNumber(data.latitude)
        && data.latitude >= -90
        && data.latitude <= 90
        && isNumber(data.longitude)
        && data.longitude >= -180
        && data.longitude <= 180
        && (data.accuracy == null || isNumber(data.accuracy))
        && data.openTime is string
        && data.openTime.size() <= 10
        && data.closeTime is string
        && data.closeTime.size() <= 10
        && data.image is string
        && data.image.size() <= 2048
        && data.bannerImage is string
        && data.bannerImage.size() <= 2048
        && data.bannerPublicId is string
        && data.bannerPublicId.size() <= 500
        && data.open is bool
        && data.published is bool
        && validApproval(data)
        && data.updatedAt is timestamp;
    }

    match /restaurants/{restaurantId} {
      allow read: if resource.data.approvalStatus == "approved"
        || (signedIn() && request.auth.uid == restaurantId);

      allow create: if signedIn()
        && validRestaurant(request.resource.data, restaurantId)
        && request.resource.data.approvalStatus == "pending";

      // The document ID is the partner UID. Validating the complete new
      // document lets older partner profiles migrate to the current schema.
      allow update: if signedIn()
        && request.auth.uid == restaurantId
        && validRestaurant(request.resource.data, restaurantId)
        && validMerchantApprovalChange();

      allow delete: if signedIn()
        && request.auth.uid == restaurantId
        && resource.data.ownerId == request.auth.uid;
    }

    function validDish(data) {
      return data.keys().hasOnly([
          "ownerId", "restaurantId", "name", "category", "dietType", "price",
          "description", "image", "imagePublicId", "active", "approvalStatus",
          "submittedAt", "reviewedAt", "reviewedBy", "source", "updatedAt"
        ])
        && data.keys().hasAll([
          "ownerId", "restaurantId", "name", "category", "dietType", "price",
          "description", "image", "imagePublicId", "active", "approvalStatus",
          "submittedAt", "reviewedAt", "reviewedBy", "source", "updatedAt"
        ])
        && data.ownerId == request.auth.uid
        && data.restaurantId == request.auth.uid
        && data.source == "hapycure-merchant"
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 60
        && (
          data.category == "Breakfast"
          || data.category == "Lunch"
          || data.category == "Dinner"
          || data.category == "Snack"
          || data.category == "Snacks"
          || data.category == "Drink"
          || data.category == "Drinks"
          || data.category == "Beverages"
          || data.category == "Dessert"
          || data.category == "Desserts"
        )
        && (
          data.dietType == "Veg"
          || data.dietType == "Non-veg"
          || data.dietType == "Non-Veg"
        )
        && isNumber(data.price)
        && data.price >= 1
        && data.price <= 100000
        && data.description is string
        && data.description.size() <= 180
        && data.image is string
        && data.image.size() > 0
        && data.image.size() <= 2048
        && data.imagePublicId is string
        && data.imagePublicId.size() <= 500
        && data.active is bool
        && validApproval(data)
        && data.updatedAt is timestamp;
    }

    match /dishes/{dishId} {
      allow read: if resource.data.approvalStatus == "approved"
        || (signedIn() && resource.data.restaurantId == request.auth.uid);

      allow create: if signedIn()
        && validDish(request.resource.data)
        && request.resource.data.approvalStatus == "pending";

      allow update: if signedIn()
        && (resource.data.ownerId == request.auth.uid
          || resource.data.restaurantId == request.auth.uid)
        && validDish(request.resource.data)
        && validMerchantApprovalChange();

      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && resource.data.restaurantId == request.auth.uid;
    }

    function validDayMenu(menu) {
      return menu is map
        && menu.keys().hasOnly([
          "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"
        ])
        && menu.keys().hasAll([
          "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"
        ])
        && menu.Monday is string && menu.Monday.size() > 0 && menu.Monday.size() <= 500
        && menu.Tuesday is string && menu.Tuesday.size() > 0 && menu.Tuesday.size() <= 500
        && menu.Wednesday is string && menu.Wednesday.size() > 0 && menu.Wednesday.size() <= 500
        && menu.Thursday is string && menu.Thursday.size() > 0 && menu.Thursday.size() <= 500
        && menu.Friday is string && menu.Friday.size() > 0 && menu.Friday.size() <= 500
        && menu.Saturday is string && menu.Saturday.size() > 0 && menu.Saturday.size() <= 500
        && menu.Sunday is string && menu.Sunday.size() > 0 && menu.Sunday.size() <= 500;
    }

    function validMealMenus(mealMenus) {
      return mealMenus is map
        && mealMenus.keys().hasOnly(["Breakfast", "Lunch", "Dinner"])
        && (!mealMenus.keys().hasAny(["Breakfast"]) || validDayMenu(mealMenus.Breakfast))
        && (!mealMenus.keys().hasAny(["Lunch"]) || validDayMenu(mealMenus.Lunch))
        && (!mealMenus.keys().hasAny(["Dinner"]) || validDayMenu(mealMenus.Dinner));
    }

    function validMessPlan(data) {
      return data.keys().hasOnly([
          "ownerId", "restaurantId", "name", "cycle", "price", "meals",
          "deliveryDays", "menu", "mealMenus", "active", "approvalStatus",
          "submittedAt", "reviewedAt", "reviewedBy", "source", "updatedAt"
        ])
        && data.keys().hasAll([
          "ownerId", "restaurantId", "name", "cycle", "price", "meals",
          "deliveryDays", "menu", "active", "approvalStatus", "submittedAt",
          "reviewedAt", "reviewedBy", "source", "updatedAt"
        ])
        && data.ownerId == request.auth.uid
        && data.restaurantId == request.auth.uid
        && data.source == "hapycure-merchant"
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 60
        && (data.cycle == "Weekly" || data.cycle == "Monthly")
        && isNumber(data.price)
        && data.price >= 1
        && data.price <= 100000
        && (
          data.meals == "Lunch"
          || data.meals == "Dinner"
          || data.meals == "Lunch & Dinner"
          || data.meals == "Breakfast, Lunch & Dinner"
        )
        && (
          data.deliveryDays == "7 days a week"
          || data.deliveryDays == "6 days a week"
          || data.deliveryDays == "Weekdays only"
        )
        && validDayMenu(data.menu)
        && (!data.keys().hasAny(["mealMenus"]) || validMealMenus(data.mealMenus))
        && data.active is bool
        && validApproval(data)
        && data.updatedAt is timestamp;
    }

    match /messPlans/{planId} {
      allow read: if resource.data.approvalStatus == "approved"
        || (signedIn() && resource.data.restaurantId == request.auth.uid);

      allow create: if signedIn()
        && validMessPlan(request.resource.data)
        && request.resource.data.approvalStatus == "pending";

      allow update: if signedIn()
        && (resource.data.ownerId == request.auth.uid
          || resource.data.restaurantId == request.auth.uid)
        && validMessPlan(request.resource.data)
        && validMerchantApprovalChange();

      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && resource.data.restaurantId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
